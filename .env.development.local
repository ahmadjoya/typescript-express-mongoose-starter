# PORT
PORT = 3000

# DATABASE
DB_HOST = 127.0.0.1
DB_PORT = 27017
DB_DATABASE = dev

# Optional: a full connection string (e.g. MongoDB Atlas) takes precedence over DB_HOST/DB_PORT/DB_DATABASE
# DB_URI = mongodb+srv://user:password@cluster.mongodb.net/dbname

# TOKEN
SECRET_KEY = secretKey

# LOG
LOG_FORMAT = dev
LOG_DIR = logs

# CORS
ORIGIN = *
CREDENTIALS = true
